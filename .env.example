# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# El sistema corre en modo DEMO con todas las variables vacías/comentadas —
# no se requiere ninguna para probar el flujo completo (ver README.md).

# --- LLM (core/llm.py) ------------------------------------------------------
# jan (default, servidor local de Jan) | openai | mock (determinista, sin red)
LLM_PROVIDER=jan
LLM_BASE_URL=http://localhost:1337/v1
LLM_MODEL=gpt-oss:latest
# Requerida si LLM_PROVIDER=openai (falla rápido al iniciar si falta, ver
# ConfigurationError en core/llm.py). Jan ignora este valor.
# LLM_API_KEY=

# --- Servidor (server.py) ---------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
# Rutas por defecto: backend/data/app.log, conversations.json, telemetry.jsonl
# (resueltas por core/paths.py). Descomenta solo para sobreescribirlas.
# LOG_FILE=
# CONV_STORE=
# TELEMETRY_LOG=

# --- Seguridad de la API (llmops/security.py) -------------------------------
# Vacía = modo demo, APIs abiertas sin autenticación (con warning al iniciar).
# Configúrala antes de exponer el servicio fuera de localhost.
# API_KEY=
# Solicitudes/minuto por cliente en /api/chat y /v1/chat/completions. 0 = sin límite.
RATE_LIMIT_PER_MINUTE=30
# Orígenes CORS separados por comas. "*" (default) para la demo local.
CORS_ORIGINS=*

# --- ServiceNow (adapters/servicenow.py) — vacío = modo DEMO ---------------
# SNOW_INSTANCE=
# SNOW_USER=
# SNOW_PASSWORD=
# SNOW_TOKEN=

# --- Notificaciones (adapters/notifications.py) — vacío = modo DEMO --------
NOTIFY_CHANNEL=slack
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# WHATSAPP_API_URL=

# --- Observabilidad — Langfuse (opcional, observability/langfuse_integration.py) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Evaluación (llmops/evals.py) -------------------------------------------
# Activa el check LLM-as-judge en el Agente de Conocimiento (cuesta una
# llamada LLM extra por consulta). true|false, default false.
# ENABLE_LLM_JUDGE=false
